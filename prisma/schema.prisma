generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?
  pseudo        String?   @unique
  firstName     String?
  lastName      String?
  birthDate     DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  xp                Int                 @default(0)
  yens              Int                 @default(0)
  accounts          Account[]
  sessions          Session[]
  questProgress     UserQuestProgress[]
  characterMemories CharacterMemory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Scenes — décors liés à un lieu (POI) ─────────────────────────────────────

model Scene {
  id              String   @id @default(cuid())
  poiId           String   @unique
  backgroundImage String?
  entrySound      String?
  ambientSound    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Characters ────────────────────────────────────────────────────────────────

model Character {
  id              String                @id @default(cuid())
  name            String
  nameJp          String
  role            String
  image           String
  systemPrompt    String                @db.Text
  greetingMessage String
  voiceId         String?
  isFriendable    Boolean               @default(false)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  greetingTranslation String? // traduction française du greetingMessage
  greetingWords       Json    @default("[]") // Word[] pré-calculé

  appearances CharacterAppearance[]
  memories    CharacterMemory[]
}

model CharacterAppearance {
  id              String    @id @default(cuid())
  characterId     String
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  poiId           String
  locationContext String?   @db.Text

  @@unique([characterId, poiId])
  @@index([poiId])
}

model CharacterMemory {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  value       String    @db.Text
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, userId, key])
  @@index([characterId, userId])
}

// ── Quest system ──────────────────────────────────────────────────────────────

model Quest {
  id           String              @id @default(cuid())
  poiId        String
  title        String
  description  String?
  order        Int                 @default(0)
  isActive     Boolean             @default(true)
  xpReward     Int                 @default(0)
  yenReward    Int                 @default(0)
  tasks        QuestTask[]
  userProgress UserQuestProgress[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([poiId])
}

model QuestTask {
  id           String             @id @default(cuid())
  questId      String
  quest        Quest              @relation(fields: [questId], references: [id], onDelete: Cascade)
  order        Int
  instruction  String
  aiContext    String?            @db.Text
  choices      TaskChoice[]
  userProgress UserTaskProgress[]
  createdAt    DateTime           @default(now())

  @@index([questId])
}

model TaskChoice {
  id        String    @id @default(cuid())
  taskId    String
  task      QuestTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  isCorrect Boolean   @default(false)
  order     Int       @default(0)

  @@index([taskId])
}

model UserQuestProgress {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  questId          String
  quest            Quest              @relation(fields: [questId], references: [id])
  status           QuestStatus        @default(IN_PROGRESS)
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  firstCompletedAt DateTime?
  taskProgress     UserTaskProgress[]

  @@unique([userId, questId])
  @@index([userId])
}

model UserTaskProgress {
  id                  String            @id @default(cuid())
  userQuestProgressId String
  userQuestProgress   UserQuestProgress @relation(fields: [userQuestProgressId], references: [id], onDelete: Cascade)
  taskId              String
  task                QuestTask         @relation(fields: [taskId], references: [id])
  status              TaskStatus        @default(PENDING)
  completedAt         DateTime?

  @@unique([userQuestProgressId, taskId])
}

enum QuestStatus {
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  PENDING
  COMPLETED
}
