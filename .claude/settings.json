{
  "permissions": {
    "allow": [
      "PowerShell(winget --version 2>&1)",
      "PowerShell(choco --version 2>&1)",
      "PowerShell(scoop --version 2>&1)",
      "PowerShell(winget install -e --id PostgreSQL.PostgreSQL.17 --accept-package-agreements --accept-source-agreements 2>&1)",
      "PowerShell(Start-Service -Name \"postgresql-x64-17\"; \\(Get-Service -Name \"postgresql-x64-17\"\\).Status)",
      "PowerShell(Get-Service | Where-Object { $_.DisplayName -match \"SQL\" } | Select-Object Name, DisplayName, Status)"
    ]
  }
}
